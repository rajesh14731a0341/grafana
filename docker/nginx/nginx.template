worker_processes 1;

events {
    worker_connections 1024;
}

http {
    include       mime.types;
    default_type  application/octet-stream;

    sendfile        on;
    keepalive_timeout 65;

    access_log /var/log/nginx/access.log;

    server {
        listen 80;

        # Health check endpoint
        location /healthz {
            return 200 'OK';
            add_header Content-Type text/plain;
        }

        # d3po-vector proxy block
        location /d3po-vector/ {
            rewrite ^/d3po-vector/(.*)$ /$1 last;
            proxy_pass http://${D3PO_VECTOR_HOST}:8686;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            include /etc/nginx/proxy-headers.conf;
        }

        # promodb-vector proxy block
        location /promodb-vector/ {
            rewrite ^/promodb-vector/(.*)$ /$1 last;
            proxy_pass http://${PROMODB_VECTOR_HOST}:8687;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            include /etc/nginx/proxy-headers.conf;
        }

        # d3po-marquez-api proxy block (strip /d3po, keep /api)
        location /d3po/api/ {
            rewrite ^/d3po(/api/.*)$ $1 break;
            proxy_pass http://${D3PO_MARQUEZ_API_HOST};
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            include /etc/nginx/proxy-headers.conf;
        }

        # promodb-marquez-api proxy block (strip /promodb, keep /api)
        location /promodb/api/ {
            rewrite ^/promodb(/api/.*)$ $1 break;
            proxy_pass http://${PROMODB_MARQUEZ_API_HOST};
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            include /etc/nginx/proxy-headers.conf;
        }
    }
}
