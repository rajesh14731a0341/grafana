worker_processes 1;

events {
    worker_connections 1024;
}

http {
    include       mime.types;
    default_type  application/octet-stream;

    sendfile        on;
    keepalive_timeout 65;

    access_log /var/log/nginx/access.log;

    server {
        listen 80;

        # Health check endpoint
        location /healthz {
            return 200 'OK';
            add_header Content-Type text/plain;
        }

        # ol-vector proxy block
        location /ol-vector/ {
            rewrite ^/ol-vector/(.*)$ /$1 last;
            proxy_pass http://${OL_VECTOR_HOST}:${OL_VECTOR_PORT};
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            include /etc/nginx/proxy-headers.conf;
        }

        # Future team paths can be added below
        # location /team-a/ { proxy_pass http://... }
    }
}
